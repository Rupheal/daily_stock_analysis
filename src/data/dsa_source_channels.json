{
  "schema_version": "1.0",
  "catalog_id": "dsa-source-channels",
  "updated_at": "2026-09-16",
  "scope": {
    "purpose": "DSA news acquisition and realtime/near-realtime market data source governance",
    "non_goals": [
      "Does not change model scoring weights",
      "Does not mark an unconfigured provider as available",
      "Does not treat search engines or aggregators as independent factual evidence"
    ]
  },
  "governance": {
    "evidence": {
      "same_economic_event_count_once": true,
      "preserve_original_publisher": true,
      "preserve_published_at": true,
      "retrieved_at_is_not_published_at": true,
      "latest_aggregate_must_not_backfill_historical_availability": true,
      "primary_source_can_confirm_own_action": true,
      "secondary_claims_need_corroboration_for_high_impact_facts": 2,
      "social_discovery_may_change_decision_without_confirmation": false
    },
    "news": {
      "dedupe_keys": ["canonical_url", "publisher", "event_identity", "title_fingerprint"],
      "search_transport_is_evidence": false,
      "aggregator_is_independent_confirmation": false,
      "default_provider_order": ["anspire", "bocha", "tavily", "brave", "serpapi", "minimax", "searxng"],
      "fail_closed_on_missing_publication_time_for_core_evidence": true
    },
    "market": {
      "preserve_existing_runtime_config": true,
      "require_source": true,
      "require_fetched_at": true,
      "provider_timestamp_preferred": true,
      "retrieved_at_is_not_price_time": true,
      "reject_future_price_for_shadow_entry": true,
      "stale_data_must_be_flagged": true,
      "fallback_on_empty_or_failure": true,
      "never_invent_quote": true
    }
  },
